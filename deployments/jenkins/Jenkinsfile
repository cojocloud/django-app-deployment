pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }

    environment {
        DOCKER_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKER_IMAGE       = "thiexco/django-app"
        DOCKER_TAG         = "latest"
        AWS_REGION         = "us-east-1"
        EKS_CLUSTER        = "django-cluster"
        K8S_NAMESPACE      = "default"
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/cojocloud/django-app-deployment.git', branch: 'main'
            }
        }

        stage('Build Image') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
            }
        }

        stage('SonarQube Analysis') {
            environment {
                SONAR_SCANNER_HOME = tool 'SonarQube Scanner'
            }
            steps {
                withSonarQubeEnv('SonarQube Server') {
                    sh "${SONAR_SCANNER_HOME}/bin/sonar-scanner"
                }
            }
        }

        stage('Trivy Scan') {
            steps {
                sh "trivy image ${DOCKER_IMAGE}:${DOCKER_TAG}"
            }
        }

        stage('Push Image') {
            steps {
                sh 'echo $DOCKER_CREDENTIALS_PSW | docker login -u $DOCKER_CREDENTIALS_USR --password-stdin'
                sh "docker push ${DOCKER_IMAGE}:${DOCKER_TAG}"
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh "aws eks --region ${AWS_REGION} update-kubeconfig --name ${EKS_CLUSTER}"
                sh "kubectl apply -f deployments/k8s/deployment.yaml --namespace=${K8S_NAMESPACE}"
                sh "kubectl apply -f deployments/k8s/service.yaml --namespace=${K8S_NAMESPACE}"
            }
        }

        stage('ArgoCD Sync') {
            steps {
                sh "argocd login \$ARGOCD_SERVER --insecure --username=admin --password=\$ARGOCD_PASSWORD"
                sh "argocd app sync django-app --namespace ${K8S_NAMESPACE}"
            }
        }
    }

    post {
        success {
            echo "Deployment successful!"
        }
        failure {
            echo "Deployment failed — check logs above."
        }
    }
}
